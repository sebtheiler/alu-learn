{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "SECRET",
    "DATABASE_URL",
    "NEXT_PUBLIC_SERVER_URL",
    "NEXT_PUBLIC_APP_ROOT_URL",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_LINK",
    "NEXT_PUBLIC_GOOGLE_ID",
    "GOOGLE_SECRET",
    "EMAIL_SERVER",
    "EMAIL_FROM",
    "CRON_SECRET_SIGNING_KEY",
    "STRIPE_ENDPOINT_SECRET",
    "STRIPE_SECRET_KEY",
    "STRIPE_MONTHLY_PRO_ID",
    "STRIPE_YEARLY_PRO_ID",
    "OPENAI_API_KEY",
    "NODE_ENV",
    "PARTNERED_DOMAINS",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "ALU_BOT_OAUTH_TOKEN",
    "SLACK_SIGNING_SECRET",
    "DO_SPACE_NAME",
    "ANALYZE_BUNDLE_SIZE",
    "NEXT_PUBLIC_ALU_PRO_TRIAL_DAYS"
  ],
  "pipeline": {
    "build": {
      "outputs": [
        ".next/**",
        "build/**",
        "!.next/cache/**"
      ],
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "pages/**/*.ts", "pages/**/*.tsx", "helpers/**/*.ts"],
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "start": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}