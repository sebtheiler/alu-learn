// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// # NextAuth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @map("refreshToken") @db.Text
  access_token      String? @map("accessToken") @db.Text
  expires_at        Int?    @map("expiresAt")
  token_type        String? @map("tokenType")
  scope             String?
  id_token          String? @map("idToken") @db.Text
  session_state     String? @map("sessionState")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// # User
model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  newUserSurveyResponse NewUserSurveyResponse?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  role  Role    @default(USER)
  isPro Boolean @default(false)

  currentStreak    Int     @default(0)
  doneReviewsToday Boolean @default(false)

  courses      Course[] @relation("CourseUsers")
  coursesOwned Course[] @relation("CourseOwners")

  uploadedImages  UploadedImage[]
  reviewInstances ReviewInstance[]

  userType              UserType @default(STUDENT)
  sendReminders         Boolean  @default(false)
  targetNumCards        Int      @default(20)
  sendMarketingResearch Boolean  @default(true)
  timezoneOffset        Int      @default(300) // GMT-5 = 300
}

enum Role {
  USER
  STAFF
  ADMIN
}

enum UserType {
  STUDENT
  TEACHER
  MIXED
}

// # Analytics
// ## New user Survey
model NewUserSurveyResponse {
  id     String  @id @default(cuid())
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @unique

  timezoneOffset Int
  userType       UserType
  referrer       Referrer
  joinReason     JoinReason
  targetNumCards Int
  sendReminders  Boolean
}

enum Referrer {
  FRIENDS
  TEACHER
  INSTA
  REDDIT
  TIKTOK
  YOUTUBE
  NEWS
  SEARCH
}

enum JoinReason {
  MEMORY
  GRADES
  CONCEPT
  TEACHER
  STUDENTS
}

// # Courses
model Course {
  id          String  @id @default(cuid())
  title       String
  bannerImage String?

  users  User[] @relation("CourseUsers")
  owners User[] @relation("CourseOwners")

  courseSections CourseSection[]
  flashcards     Flashcard[]
}

model CourseSection {
  id    String @id @default(cuid())
  title String
  slug  String

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  subSections SubSection[]
}

model SubSection {
  id    String @id @default(cuid())
  title String
  slug  String

  courseSection   CourseSection @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  courseSectionId String

  flashcards Flashcard[]
}

// ## Flashcards
model Flashcard {
  id String @id @default(cuid())

  fields String // Stored as string over Json for simplicity in searching the value
  tags   String @default("")

  subSection   SubSection @relation(fields: [subSectionId], references: [id], onDelete: Cascade)
  subSectionId String

  type FlashcardType @default(NORMAL)

  reviewInstances ReviewInstance[]

  // Although this is redundant, it often saves database operations
  // and is therefore useful
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
}

enum FlashcardType {
  NORMAL
  CLOZE
}

model ReviewInstance {
  id String @id @default(cuid())

  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  flashcardId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  learningStatus LearningStatus @default(UNSEEN)
  stepsIndex     Int            @default(0)
  ease           Int            @default(250)
  nextReview     DateTime
  lastReview     DateTime?
  // isSuspended Boolean
  // leechIndex Int
}

enum LearningStatus {
  UNSEEN
  LEARNING
  LEARNED
  RELEARNING
}

// # Other
model UploadedImage {
  id  String @id @default(cuid())
  url String

  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?

  width  Int?
  height Int?
}
