{
  "name": "alu-read",
  "version": "0.0.1",
  "description": "An incremental reading desktop app that allows you to read and watch thousands of articles, books, and videos simultaneously",
  "repository": "https://github.com/sebtheiler/Alu",
  "main": "dist/server/main.js",
  "scripts": {
    "dev": "pnpm run build-lite && concurrently 'next dev -p 5173' 'cross-env NODE_ENV=development electron .'",
    "build": "next build && prisma generate && tsc --build && node copy-files.js && node install-engines-on-mac.js",
    "build-lite": "prisma generate && cd src/server && tsc --build --verbose && cd ../.. && node copy-files.js && node install-engines-on-mac.js",
    "start": "pnpm run build && concurrently 'next start -p 5173' 'cross-env NODE_ENV=development electron .'",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "publish": "pnpm run build && dotenv -- electron-builder -p always",
    "check-types": "tsc --noemit",
    "lint": "npm run check-types && next lint",
    "prettify": "pretty-quick"
  },
  "files": [
    "build",
    "helpers",
    "lib",
    "public",
    "src",
    "globals.ts",
    "keyboardShortcuts.ts",
    ".env"
  ],
  "author": "Sebastian Theiler",
  "license": "MIT",
  "dependencies": {
    "@apollo/client": "^3.7.9",
    "@fortawesome/fontawesome-svg-core": "^6.3.0",
    "@fortawesome/free-solid-svg-icons": "^6.3.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@mozilla/readability": "^0.4.2",
    "@paralleldrive/cuid2": "^2.2.0",
    "@prisma/client": "^4.11.0",
    "@prisma/engines": "^4.11.0",
    "@tanstack/react-query": "^4.20.4",
    "@trpc/client": "^10.5.0",
    "@trpc/react-query": "^10.5.0",
    "@trpc/server": "^10.5.0",
    "alu-ui": "workspace:*",
    "axios": "^1.3.3",
    "base64url": "^3.0.1",
    "cheerio": "1.0.0-rc.12",
    "dompurify": "^3.0.1",
    "electron-context-menu": "^3.6.1",
    "electron-fetch": "^1.9.1",
    "electron-log": "^4.4.8",
    "graphql": "^16.6.0",
    "helpers-lib": "workspace:*",
    "lexical": "^0.8.1",
    "lexical-editor": "workspace:*",
    "mime-types": "^2.1.35",
    "next": "^13.1.6",
    "prisma": "^4.11.0",
    "react": "^18.2.0",
    "react-complex-tree": "^2.0.4",
    "react-dom": "^18.2.0",
    "react-pdf": "^6.2.2",
    "react-player": "^2.11.2",
    "superjson": "^1.12.1",
    "zod": "^3.20.2"
  },
  "devDependencies": {
    "@types/dompurify": "^2.4.0",
    "@types/node": "^18.11.17",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@types/react-pdf": "^6.2.0",
    "concurrently": "^7.6.0",
    "config": "workspace:*",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "dotenv-cli": "^6.0.0",
    "electron": "^22.0.0",
    "electron-builder": "^23.6.0",
    "electron-notarize": "^1.2.1",
    "eslint-config-custom": "workspace:*",
    "fs-extra": "^11.1.0",
    "prettier": "2.8.4",
    "prettier-plugin-prisma": "^4.10.0",
    "pretty-quick": "^3.1.3",
    "replace-in-file": "^6.3.5",
    "typescript": "^4.9.5"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
