generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// # NextAuth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @map("refreshToken") @db.Text
  access_token      String? @map("accessToken") @db.Text
  expires_at        Int?    @map("expiresAt")
  token_type        String? @map("tokenType")
  scope             String?
  id_token          String? @map("idToken") @db.Text
  session_state     String? @map("sessionState")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// # User
model User {
  OLD_ID         Int? @unique
  OLD_PROFILE_ID Int? @unique

  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  newUserSurveyResponse NewUserSurveyResponse?
  dailyVisits           UserVisit[]
  urlHits               UrlHit[]
  flashcardReports      FlashcardReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  friends          User[] @relation("Friends")
  friendUsers      User[] @relation("Friends")
  friendsRequested User[] @relation("FriendsRequested") // users that the given user wants to be friends with
  requestedFriends User[] @relation("FriendsRequested") // users that want to be friends with the given user

  usersReferred User[]  @relation("UserReferrals")
  referredBy    User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: Cascade)
  referredById  String? @unique

  stripeCustomerAccount StripeCustomer?
  isPro                 Boolean         @default(false)
  isProFromOrg          Boolean         @default(false)
  proTrialExpires       DateTime?

  role        Role    @default(USER)
  isSuperUser Boolean @default(false)
  isStaff     Boolean @default(false)
  isActive    Boolean @default(true)

  currentStreak    Int     @default(0)
  longestStreak    Int     @default(0)
  doneReviewsToday Boolean @default(false)

  courses         Course[] @relation("CourseUsers")
  coursesArchived Course[] @relation("CourseArchivedUsers")
  coursesOwned    Course[] @relation("CourseOwners")

  classesTaught     Classroom[] @relation("ClassroomTeachers")
  classesEnrolledIn Classroom[] @relation("ClassroomStudents")

  uploadedImages  UploadedImage[]
  reviewInstances ReviewInstance[]
  history         HistorySegment[]

  userType            UserType @default(STUDENT)
  targetNumReviews    Int      @default(20)
  numReviewsDoneToday Int      @default(0)
  timezoneOffset      Int      @default(300) // GMT-5 = 300

  numAutoFlashcardsGenerated Int                        @default(0)
  generatedFlashcards        AutoFlashcardsGeneration[]

  sendReminders         Boolean   @default(false)
  sendMarketingResearch Boolean   @default(true)
  sendWeeklyReports     Boolean   @default(true)
  sendGeneral           Boolean   @default(true)
  unsubscribeAll        Boolean   @default(false)
  sentReengagement      DateTime?

  selectedAluReadCourseId  String?

  // For Algorithm Research
  dayChosenForAlgorithmResearch DateTime?
}

enum Role {
  USER
  STAFF
  ADMIN
}

enum UserType {
  STUDENT
  TEACHER
  MIXED
}

// # Analytics
// ## New user Survey
model NewUserSurveyResponse {
  id        String    @id @default(cuid())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?   @unique
  timestamp DateTime? @default(now())

  timezoneOffset   Int
  userType         UserType
  referrer         Referrer
  joinReason       JoinReason
  targetNumReviews Int
  sendReminders    Boolean
}

enum Referrer {
  FRIENDS
  TEACHER
  INSTA
  REDDIT
  TIKTOK
  YOUTUBE
  NEWS
  SEARCH
}

enum JoinReason {
  MEMORY
  GRADES
  CONCEPT
  AUTOFLASHCARDS
  TEACHER
  STUDENTS
}

// ## Daily User Visit
model UserVisit {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  remoteAddr String?
  userAgent  String?
  timestamp  DateTime @default(now()) @db.Timestamptz(3)
}

// ## URL Shortener
model ShortUrl {
  id          String   @id @default(cuid())
  code        String   @unique
  destination String
  hits        UrlHit[]
}

model UrlHit {
  id String @id @default(cuid())

  shortUrl   ShortUrl @relation(fields: [shortUrlId], references: [id], onDelete: Cascade)
  shortUrlId String
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?

  timestamp  DateTime @default(now())
  userAgent  String?
  remoteAddr String?
  referer    String?
}

// ## Reports
model FlashcardReport {
  id String @id @default(cuid())

  flashcard   Flashcard? @relation(fields: [flashcardId], references: [id], onDelete: SetNull)
  flashcardId String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?

  reasons   String
  timestamp DateTime @default(now())
}

// ## Auto Flashcards Usage
model AutoFlashcardsGeneration {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  inputText       String
  generatedOutput String
}

// # Courses
model Course {
  OLD_ID Int? @unique

  id             String  @id @default(cuid())
  title          String
  bannerImage    String?
  description    String? // Stringified Lexical state
  seoDescription String?
  seoSubject     String?

  users         User[] @relation("CourseUsers")
  archivedUsers User[] @relation("CourseArchivedUsers")
  owners        User[] @relation("CourseOwners")

  courseSections CourseSection[]
  flashcards     Flashcard[]

  privacySetting PrivacySetting @default(ALL)
  editingAccess  EditingAccess  @default(OWNERS)
  isPublic       Boolean        @default(false)

  classrooms Classroom[]

  // For Algorithm Research
  algorithmResearchSpanishLevel String?
}

enum PrivacySetting {
  ALL
  FRIENDS
  INSTITUTION
  PRIVATE
}

enum EditingAccess {
  OWNERS
  ALL
  FRIENDS
  INSTITUTION
}

model CourseSection {
  id          String @id @default(cuid())
  slug        String
  title       String
  description String @default("")
  color       String @default("BLUE")

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  subSections SubSection[]

  index Int
}

model SubSection {
  id    String @id @default(cuid())
  title String
  slug  String

  courseSection   CourseSection @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  courseSectionId String

  flashcards Flashcard[]

  assignments Assignment[]

  index Int
}

// ## Flashcards
model Flashcard {
  OLD_ID           String? @unique
  OLD_UNIVERSAL_ID String?

  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  fields String // Stored as string over Json for simplicity in searching the value
  tags   String @default("")
  type FlashcardType @default(NORMAL)
  index Int

  subSection   SubSection @relation(fields: [subSectionId], references: [id], onDelete: Cascade)
  subSectionId String

  reviewInstances ReviewInstance[]
  reports FlashcardReport[]

  extractId String?

  // Although this is redundant, it often saves database operations
  // and is therefore useful
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
}

enum FlashcardType {
  NORMAL
  CLOZE
}

model ReviewInstance {
  OLD_ID String? @unique

  id String @id @default(cuid())

  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  flashcardId String
  name        String? // used in cloze flashcards to differentiate colors

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  learningStatus LearningStatus @default(UNSEEN)
  stepsIndex     Int            @default(0)
  ease           Int            @default(250)
  nextReview     DateTime
  lastReview     DateTime?

  isStarred Boolean @default(false)
  // isSuspended Boolean @default(false)
  // leechIndex Int @default(0)

  history ReviewInstanceHistory[]

  // For Algorithm Research
  algorithmResearchGroup AlgorithmResearchGroup?
  customData             Json? // Additional information for the spaced repetition algorithm
}

enum LearningStatus {
  UNSEEN
  LEARNING
  LEARNED
  RELEARNING
}

enum AlgorithmResearchGroup {
  NOT_SHOWN_CONTROL
  SM2
  EBISU
  SSP_MMC
}

model ReviewInstanceHistory {
  id                     String          @id @default(cuid())
  reviewInstance         ReviewInstance? @relation(fields: [reviewInstanceId], references: [id], onDelete: SetNull)
  reviewInstanceId       String?
  backupReviewInstanceId String?

  gradeResponse  GradeResponse
  timeTaken      Float
  ease           Int
  learningStatus LearningStatus
  stepsIndex     Int
  nextReview     DateTime
  lastReview     DateTime?

  timestamp DateTime @default(now())
}

enum GradeResponse {
  AGAIN
  HARD
  GOOD
  EASY
}

// # Other
model UploadedImage {
  id  String @id @default(cuid())
  url String

  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?

  width  Int?
  height Int?
}

model HistorySegment {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  date           DateTime @db.Date
  reviewsStudied Int      @default(0)
  timeTaken      Float    @default(0)
}

// # Stripe
model StripeCustomer {
  id                   String @id @default(cuid())
  stripeCustomerId     String @unique
  stripeSubscriptionId String

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

// # Teachers & Classrooms
model Classroom {
  id       String @id @default(cuid())
  title    String
  joinCode String @unique @db.VarChar(8)

  teachers User[] @relation("ClassroomTeachers")
  students User[] @relation("ClassroomStudents")

  assignments Assignment[]
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseId    String?
}

model Assignment {
  id            String  @id @default(cuid())
  title         String
  essentialOnly Boolean @default(false)

  assignedSubSections SubSection[]
  classrooms          Classroom[]
}
